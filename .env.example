# =============================================================================
# Variables de entorno de DoctorCita
# =============================================================================
# Copia este archivo como `.env` y rellena los valores de tu proyecto de
# Supabase: Project Settings -> API Keys.
#
# NOTA: el `.env` real está versionado en este repositorio porque lo gestiona
# Lovable. Eso solo es aceptable mientras únicamente contenga la clave
# PUBLISHABLE, que viaja al navegador de todos modos y no otorga permisos por sí
# sola — quien decide qué puede leer cada quien es el RLS de PostgreSQL.
#
# NUNCA pongas aquí ni en `.env` la clave `service_role` ni la contraseña de la
# base de datos: esas sí saltan el RLS por completo. Para el despliegue en
# Vercel, cualquier secreto va en Project Settings -> Environment Variables.
# =============================================================================

# Identificador del proyecto de Supabase.
SUPABASE_PROJECT_ID="tu-project-ref"
VITE_SUPABASE_PROJECT_ID="tu-project-ref"

# URL de la API.
SUPABASE_URL="https://tu-project-ref.supabase.co"
VITE_SUPABASE_URL="https://tu-project-ref.supabase.co"

# Clave publishable (antes "anon"). Es pública por diseño.
# Formato nuevo: sb_publishable_...   ·   Formato antiguo: eyJhbGciOi...
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# -----------------------------------------------------------------------------
# Solo para herramientas de desarrollo (NO se usa en la aplicación)
# -----------------------------------------------------------------------------
# La contraseña de la base de datos que usan `supabase db push` y
# `bun run db:sql`. No la pongas en este archivo: configúrala como variable de
# entorno de tu usuario con `.\configurar-supabase.ps1`, para que no acabe en
# ningún archivo del repositorio.
#
# SUPABASE_DB_PASSWORD=  <- déjala vacía aquí a propósito
